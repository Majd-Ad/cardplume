# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
# Both values are safe in the browser bundle. The anon key is public by design; what it can
# reach is decided by the row-level security policies in supabase/schema.sql, not by secrecy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
